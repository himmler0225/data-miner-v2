API_KEYS=

# MCP server (expose crawl tools to ai-layer)
MCP_ENABLED=true
MCP_SSE_PATH=/mcp
# MCP_AUTH_TOKEN=              # optional Bearer token for /mcp/*

TIKAP_API_KEY=

# Tavily — web search API dùng cho /api/google/search (search tool cho AI)
TAVILY_API_KEY=

# Supabase — remote config (proxies, rate limits). Không dùng Postgres trực tiếp.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=
